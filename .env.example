# ============================================
#  Configuración del Asistente IA
#  Copiá este archivo como ".env" y completá tus valores.
#  Reiniciá "npm run dev" después de cambiarlo.
# ============================================

# --------------------------------------------
#  SECRETOS (sin prefijo VITE_)
#  Solo los lee el servidor: el proxy de Vite en local
#  y la función /api en Vercel. NUNCA llegan al navegador.
# --------------------------------------------

# URL base de cualquier API compatible con OpenAI
# Ejemplos:
#   llama.cpp local  -> http://127.0.0.1:8080/v1
#   Ollama local     -> http://localhost:11434/v1
#   OpenAI           -> https://api.openai.com/v1
#   Groq             -> https://api.groq.com/openai/v1
#   OpenRouter       -> https://openrouter.ai/api/v1
#   Google Gemini    -> https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=http://127.0.0.1:8080/v1

# Tu API key (dejala vacía si usás un modelo local)
LLM_API_KEY=

# --------------------------------------------
#  PÚBLICAS (con prefijo VITE_)
#  Llegan al navegador: no pongas secretos acá.
# --------------------------------------------

# Nombre del modelo (ej: gpt-4o-mini, llama-3.1-8b-instant, gemini-2.0-flash)
VITE_LLM_MODEL=default

# Creatividad de 0 a 2 (más bajo = respuestas más precisas)
VITE_LLM_TEMPERATURE=0.7

# true = el texto aparece de a poco | false = aparece todo junto
VITE_LLM_STREAMING=true
